# OpenAI API Key (required for RAG functionality)
OPENAI_API_KEY=OPENAI_API_KEY
HUGGINGFACE_API_KEY=HUGGINGFACE_API_KEY

# Model provider options (openai, huggingface, or mock)
MODEL_PROVIDER=huggingface

# HuggingFace model options
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_LLM_MODEL=google/flan-t5-base

# Retry configuration
MAX_RETRIES=3
RETRY_BACKOFF=2

# Optional configurations
LOG_LEVEL=INFO
VECTOR_STORE_PATH=/app/vectorstore  # Customize if needed
DATA_DIR=/app/data                  # Customize if needed

# FastAPI configuration
API_HOST=0.0.0.0
API_PORT=8000

# Airflow configuration
AIRFLOW_UID=50000

# Feature toggles
USE_REAL_RAG=true  # Set to "true" to enable the real RAG implementation
